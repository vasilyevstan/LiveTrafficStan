{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "livetrafficstan",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": true,
  "preview_urls": false,
  "exports": {
    "FlightRouteQuota": {
      "type": "durable-object",
      "state": "deleted"
    },
    "MarineTrafficRelay": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vpc_services": [
    {
      "binding": "AIRCRAFT_RELAY",
      "service_id": "01a0df44-6600-79a2-a14f-88b6606869fb"
    }
  ]
}
