{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "livetrafficstan",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "AVIATIONSTACK_ENABLED": "false"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FLIGHT_ROUTE_QUOTA",
        "class_name": "FlightRouteQuota"
      }
    ]
  },
  "exports": {
    "FlightRouteQuota": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  }
}
