{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "livetrafficstan",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": true,
  "preview_urls": false,
  "exports": {
    "FlightRouteQuota": {
      "type": "durable-object",
      "state": "deleted"
    }
  },
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  }
}
