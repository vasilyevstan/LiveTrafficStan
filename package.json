{
  "name": "livetrafficstan",
  "private": true,
  "version": "1.3.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:aircraft-metadata": "node scripts/check-aircraft-metadata.mjs",
    "check:airports": "node scripts/check-airports.mjs",
    "check:ports": "node scripts/check-ports.mjs",
    "check:deploy": "wrangler deploy --dry-run",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint .",
    "preview:worker": "npm run build && wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "update:aircraft-metadata": "node scripts/update-aircraft-metadata.mjs",
    "update:airports": "node scripts/update-airports.mjs",
    "update:ports": "node scripts/update-ports.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "maplibre-gl": "^6.10.0",
    "mqtt": "^5.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "4.135.0"
  }
}
