[Unit]
Description=LiveTrafficStan private Cloudflare Tunnel
After=network-online.target livetrafficstan-aircraft-relay.service
Wants=network-online.target
Requires=livetrafficstan-aircraft-relay.service

[Service]
Type=notify
User=livetrafficstan-cloudflared
Group=livetrafficstan-cloudflared
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate --protocol quic --edge-ip-version 6 run --token-file /etc/livetrafficstan-cloudflared-token
Restart=always
RestartSec=5s
TimeoutStartSec=60s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectHostname=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
